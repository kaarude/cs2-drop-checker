<Window x:Class="Cs2DropChecker.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        xmlns:o="clr-namespace:Cs2DropChecker.App.Overlay"
        Title="CS2 Drop Checker overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        Width="200" Height="512" Left="-4000" Top="-4000"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">
  <Window.Resources>
    <LinearGradientBrush x:Key="CardInner" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#0c131e" Offset="0" />
      <GradientStop Color="#080d15" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#de9b35" Offset="0" />
      <GradientStop Color="#5d79ae" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Shimmer" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#203b4a63" Offset="0" />
      <GradientStop Color="#b0a9c1ec" Offset="0.5" />
      <GradientStop Color="#203b4a63" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="CardChip" TargetType="Border">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#735d79ae" />
      <Setter Property="Padding" Value="5,1,5,1" />
      <Setter Property="Margin" Value="0,0,4,3" />
    </Style>

    <DataTemplate DataType="{x:Type o:CardViewModel}">
      <c:CutBorder Width="190" Height="288" Cut="13" Corners="TopRight,BottomLeft" BorderThickness="1"
                   BorderBrush="{Binding BorderBrush}" Background="{StaticResource CardInner}">
        <Grid>
          <Rectangle Fill="{Binding TintBrush}" />
          <Rectangle Fill="{StaticResource Scanlines}" />
          <Grid Height="20" VerticalAlignment="Top">
            <c:CutBorder Shape="TagRight" Slant="8" Background="{Binding TagBrush}" HorizontalAlignment="Left" Padding="9,0,16,0">
              <c:TrackedText Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Spacing="1.3" Foreground="#0d1118" VerticalAlignment="Center" />
            </c:CutBorder>
            <c:TrackedText Text="{Binding Age}" FontSize="8.5" FontWeight="SemiBold" Spacing="1.3" Foreground="#8fa0b6"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0" />
          </Grid>
          <Image c:Img.DecodeWidth="360" c:Img.Icon="{Binding IconUrl}" Width="166" Height="104" Margin="0,26,0,0"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Stretch="Uniform" />
          <StackPanel VerticalAlignment="Bottom" Margin="11,0,11,14">
            <c:TrackedText Text="{Binding RarityLine}" FontSize="9.5" FontWeight="Bold" Spacing="1.3" Foreground="{Binding RarityBrush}" />
            <c:TrackedText Text="{Binding Weapon}" FontSize="9.5" Spacing="1" Foreground="#9fb0c6" Margin="0,2,0,0" />
            <c:TrackedText Text="{Binding Skin}" FontSize="16.5" FontWeight="Bold" Spacing="0.6" Foreground="#f2f5f8" Margin="0,1,0,0"
                           Visibility="{Binding LongSkin, Converter={StaticResource Vis}, ConverterParameter=!}" />
            <TextBlock Text="{Binding SkinUpper}" FontSize="14" FontWeight="Bold" Foreground="#f2f5f8" Margin="0,1,0,0" TextWrapping="Wrap"
                       LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="35" TextTrimming="CharacterEllipsis" Visibility="{Binding LongSkin, Converter={StaticResource Vis}}" />
            <WrapPanel Margin="0,5,0,0">
              <Border Style="{StaticResource CardChip}" Visibility="{Binding WearChip, Converter={StaticResource Vis}}">
                <c:TrackedText Text="{Binding WearChip}" FontSize="9" Spacing="0.8" Foreground="#c9d2de" />
              </Border>
              <Border Style="{StaticResource CardChip}" BorderBrush="#cf6a32" Visibility="{Binding StatTrak, Converter={StaticResource Vis}}">
                <c:TrackedText Text="StatTrak™" FontSize="9" Spacing="0.8" Foreground="#ff9b5e" />
              </Border>
              <Border Style="{StaticResource CardChip}" BorderBrush="#c9a400" Visibility="{Binding Souvenir, Converter={StaticResource Vis}}">
                <c:TrackedText Text="Souvenir" FontSize="9" Spacing="0.8" Foreground="#ffd54a" />
              </Border>
            </WrapPanel>
            <Grid Margin="0,2,0,0" Visibility="{Binding Warn, Converter={StaticResource Vis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path x:Name="warnIco" Data="{StaticResource IcoInfo}" Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.3"
                    Stroke="#f3b350" VerticalAlignment="Top" Margin="0,1,5,0" />
              <TextBlock x:Name="warnText" Grid.Column="1" Text="{Binding WarnUpper}" FontSize="9" FontWeight="SemiBold" Foreground="#f3b350"
                         TextWrapping="Wrap" LineHeight="11" />
            </Grid>
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
              <c:TrackedText DockPanel.Dock="Right" Text="{Binding Source}" FontSize="8.5" Spacing="1.1" Foreground="#7f8ea3"
                             VerticalAlignment="Bottom" Margin="6,0,0,5" Trim="False" />
              <Grid>
              <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" Height="28"
                       Visibility="{Binding Pending, Converter={StaticResource Vis}, ConverterParameter=!}">
                <TextBlock Text="{Binding Price}" FontSize="21" FontWeight="Bold" Foreground="#f3b350" />
              </Viewbox>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="25"
                          Visibility="{Binding Pending, Converter={StaticResource Vis}}">
                <c:TrackedText Text="Fetching" FontSize="10" FontWeight="SemiBold" Spacing="1.3" Foreground="#a9c1ec" VerticalAlignment="Center" />
                <Rectangle Width="58" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{StaticResource Shimmer}">
                  <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="20">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.6" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Rectangle.Triggers>
                </Rectangle>
              </StackPanel>
              </Grid>
            </DockPanel>
          </StackPanel>
          <Rectangle Height="3" Fill="#7fa0e0" VerticalAlignment="Bottom" Margin="0,0,0,4" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
              <ScaleTransform ScaleX="{Binding Remaining}" />
            </Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Height="4" Fill="{Binding RarityBrush}" VerticalAlignment="Bottom" />
        </Grid>
      </c:CutBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding WarnLate}" Value="True">
          <Setter TargetName="warnIco" Property="Stroke" Value="#8fb8ff" />
          <Setter TargetName="warnText" Property="Foreground" Value="#8fb8ff" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type o:ValuePanelViewModel}">
      <c:CutBorder Width="240" Cut="12" Corners="TopRight,BottomLeft" BorderThickness="1"
                   BorderBrush="{StaticResource PanelBorder}" Background="{StaticResource CardInner}">
        <Grid>
          <Rectangle Fill="{StaticResource Scanlines}" />
          <StackPanel>
            <Grid Height="18">
              <c:CutBorder Shape="TagRight" Slant="8" Background="#de9b35" HorizontalAlignment="Left" Padding="9,0,16,0">
                <c:TrackedText Text="Inventory value" FontSize="9" FontWeight="Bold" Spacing="1.3" Foreground="#0d1118" VerticalAlignment="Center" />
              </c:CutBorder>
              <c:TrackedText Text="{Binding Priced}" FontSize="8.5" FontWeight="SemiBold" Spacing="1.2" Foreground="#a9c1ec"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" />
            </Grid>
            <StackPanel Margin="11,7,11,10">
              <TextBlock Text="{Binding Total}" FontSize="30" FontWeight="Bold" Foreground="#f3b350" />
              <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                <Path x:Name="up" Data="M0,6 L3.5,0 L7,6 Z" Fill="#8fd19a" Width="7" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                      Visibility="{Binding HasDelta, Converter={StaticResource Vis}}" />
                <c:TrackedText x:Name="delta" Text="{Binding Delta}" FontSize="9.5" FontWeight="SemiBold" Spacing="1" Foreground="#8fd19a" />
              </StackPanel>
              <c:SegmentBar Segments="{Binding Groups}" Gap="2" Height="6" Margin="0,9,0,7" />
              <ItemsControl ItemsSource="{Binding Legend}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#1f5d79ae" BorderThickness="0,1,0,0" Padding="0,3.5,0,3.5">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="7" Height="7" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <c:TrackedText Grid.Column="1" Text="{Binding Name}" FontSize="10" Spacing="1" Foreground="#c9d2de" />
                        <c:TrackedText Grid.Column="2" Text="{Binding Value}" FontSize="10" FontWeight="SemiBold" Spacing="0.6" Foreground="#e6ebf1" Upper="False" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:TrackedText Text="{Binding Footer}" FontSize="8.5" Spacing="1.1" Foreground="#7f8ea3" Margin="0,6,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </c:CutBorder>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DeltaDown}" Value="True">
          <Setter TargetName="up" Property="Data" Value="M0,0 L7,0 L3.5,6 Z" />
          <Setter TargetName="up" Property="Fill" Value="#ef7a7a" />
          <Setter TargetName="delta" Property="Foreground" Value="#ef7a7a" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Scaler" Width="250" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">
    <StackPanel x:Name="Stack" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
      <ContentPresenter Content="{Binding Card}" />
      <c:CutBorder Shape="Parallelogram" Slant="6" Background="#de9b35" Padding="12,2,12,2" Margin="0,5,0,0"
                   Visibility="{Binding ShowQueue, Converter={StaticResource Vis}}">
        <c:TrackedText Text="{Binding QueueText}" FontSize="9" FontWeight="Bold" Spacing="1.2" Foreground="#0d1118" />
      </c:CutBorder>
      <!-- A ContentPresenter's own bindings resolve against its Content, so the visibility sits on a wrapper. -->
      <Border Margin="0,8,0,0" Visibility="{Binding ShowValue, Converter={StaticResource Vis}}">
        <ContentPresenter Content="{Binding Value}" />
      </Border>
      <Border Background="#f20c131e" BorderBrush="#735d79ae" BorderThickness="1" Padding="9,5" Margin="0,8,0,0"
              Visibility="{Binding Toast, Converter={StaticResource Vis}}">
        <StackPanel Orientation="Horizontal">
          <Rectangle x:Name="ToastDot" Width="7" Height="7" VerticalAlignment="Center">
            <Rectangle.Style>
              <Style TargetType="Rectangle">
                <Setter Property="Fill" Value="#6f7f95" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToastOn}" Value="True">
                    <Setter Property="Fill" Value="#de9b35" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Rectangle.Style>
          </Rectangle>
          <c:TrackedText Text="{Binding Toast}" FontSize="10" FontWeight="Bold" Spacing="1.3" Foreground="#e6ebf1" Margin="8,0,10,0" VerticalAlignment="Center" />
          <Border Background="#c9d2de" Padding="5,1" VerticalAlignment="Center" Visibility="{Binding ToastKey, Converter={StaticResource Vis}}">
            <c:TrackedText Text="{Binding ToastKey}" FontSize="9" FontWeight="SemiBold" Spacing="1" Foreground="#0b1119" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
