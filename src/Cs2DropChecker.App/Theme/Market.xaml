<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">

  <!-- Price option in the sell dialog -->
  <Style x:Key="ChoiceRow" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="#0a0f16" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Padding="12,7,14,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="ring" Stroke="{StaticResource LineStrong}" StrokeThickness="1.4" />
                <Ellipse x:Name="dot" Fill="{StaticResource Accent}" Margin="3.5" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Blue}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="bd" Property="Background" Value="#14de9b35" />
              <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
              <Setter TargetName="dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ghost button that turns red on hover, for removing listings -->
  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <c:TrackedText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Spacing="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Down}" />
              <Setter Property="Foreground" Value="{StaticResource Down}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#26ef7a7a" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Yellow sidebar button shown when a newer release exists. Tag carries download progress 0..1. -->
  <Style x:Key="UpdateButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="#f2c94c" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Tag" Value="0.0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <c:CutBorder x:Name="bd" Background="{TemplateBinding Background}" Cut="9" Corners="TopRight,BottomLeft">
            <Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M7,1.5 V9.5 M3.5,6 L7,9.5 L10.5,6 M2,12.5 H12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <c:TrackedText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Spacing="1.4" VerticalAlignment="Center" />
              </StackPanel>
              <Rectangle Height="3" VerticalAlignment="Bottom" Margin="10,0,10,4" Fill="#a60b1119" RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                  <ScaleTransform ScaleX="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Rectangle.RenderTransform>
              </Rectangle>
            </Grid>
          </c:CutBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#f7d872" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#deb43a" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Warning line with an info icon -->
  <DataTemplate x:Key="WarnLine">
    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path Data="{StaticResource IcoInfo}" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.4" Stroke="{StaticResource Warn}"
            VerticalAlignment="Top" Margin="0,3,8,0" />
      <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Note}" Foreground="{StaticResource Warn}" FontSize="12" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
