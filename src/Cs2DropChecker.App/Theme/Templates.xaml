<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
                    xmlns:vm="clr-namespace:Cs2DropChecker.App.ViewModels">

  <!-- Shortcut shown as key caps: Ctrl + Shift + O -->
  <DataTemplate x:Key="KeyCap">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="plus" Text="+" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
      <Border Background="#c9d2de" Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center">
        <c:TrackedText Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Spacing="0.8" Foreground="#0b1119" />
      </Border>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
        <Setter TargetName="plus" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="Horizontal">
    <StackPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="Wrap">
    <WrapPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

  <!-- Drop table -->
  <Style x:Key="ColHead" TargetType="c:TrackedText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Spacing" Value="1.4" />
    <Setter Property="Foreground" Value="{StaticResource Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Cell" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <ControlTemplate x:Key="DropHeader" TargetType="ContentControl">
    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Height="30">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" MinWidth="180" />
          <ColumnDefinition Width="122" />
          <ColumnDefinition Width="216" />
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <c:TrackedText Grid.Column="1" Style="{StaticResource ColHead}" Text="When" Margin="9,0,0,0" />
        <c:TrackedText Grid.Column="2" Style="{StaticResource ColHead}" Text="Item" Margin="2,0,0,0" />
        <c:TrackedText Grid.Column="3" Style="{StaticResource ColHead}" Text="How" />
        <c:TrackedText Grid.Column="4" Style="{StaticResource ColHead}" Text="Flags" />
        <c:TrackedText Grid.Column="5" Style="{StaticResource ColHead}" Text="At drop" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="6" Style="{StaticResource ColHead}" Text="Now" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="7" Style="{StaticResource ColHead}" Text="Price source" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </ControlTemplate>

  <DataTemplate x:Key="DropRow" DataType="{x:Type vm:DropRowViewModel}">
    <Border x:Name="row" BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Height="38" Background="Transparent" Cursor="Hand"
            ToolTip="Click for selling options">
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectDropCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
      </Border.InputBindings>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" MinWidth="180" />
          <ColumnDefinition Width="122" />
          <ColumnDefinition Width="216" />
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <Rectangle Fill="{Binding RarityHex, Converter={StaticResource HexBrush}}" Margin="0,8" />
        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding When}" Margin="9,0,0,0" FontSize="11.5" />
        <Grid Grid.Column="2" Margin="0,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image c:Img.DecodeWidth="96" c:Img.Icon="{Binding IconUrl}" Width="42" Height="30" Margin="0,0,10,0" Stretch="Uniform" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <c:TrackedText Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Spacing="0.8" Foreground="{StaticResource Text}" />
            <TextBlock Text="{Binding Wear}" FontSize="10.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding How}" />
        <ItemsControl Grid.Column="4" ItemsSource="{Binding Flags}" ItemTemplate="{StaticResource PillTemplate}"
                      ItemsPanel="{StaticResource Horizontal}" VerticalAlignment="Center" ClipToBounds="True" Focusable="False" />
        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding AtDrop}" HorizontalAlignment="Right" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Path x:Name="trend" Width="7" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock x:Name="now" Style="{StaticResource Cell}" Text="{Binding Now}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Column="7" Style="{StaticResource Cell}" Text="{Binding Source}" Margin="16,0,0,0" FontSize="11.5" />
        <Button Grid.Column="8" Style="{StaticResource IconButton}" Content="{StaticResource IcoShare}" ToolTip="Share card: copy to clipboard and save as PNG"
                AutomationProperties.Name="Share"
                Command="{Binding DataContext.ShareDropCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
        <Setter TargetName="row" Property="Background" Value="#0affffff" />
      </Trigger>
      <DataTrigger Binding="{Binding Trend}" Value="up">
        <Setter TargetName="trend" Property="Visibility" Value="Visible" />
        <Setter TargetName="trend" Property="Data" Value="M0,6 L3.5,0 L7,6 Z" />
        <Setter TargetName="trend" Property="Fill" Value="{StaticResource Up}" />
        <Setter TargetName="now" Property="Foreground" Value="{StaticResource Up}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Trend}" Value="down">
        <Setter TargetName="trend" Property="Visibility" Value="Visible" />
        <Setter TargetName="trend" Property="Data" Value="M0,0 L7,0 L3.5,6 Z" />
        <Setter TargetName="trend" Property="Fill" Value="{StaticResource Down}" />
        <Setter TargetName="now" Property="Foreground" Value="{StaticResource Down}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Inventory tile -->
  <Geometry x:Key="IcoLock">M3,7 V5 A4,4 0 0 1 11,5 V7 M1.5,7 H12.5 V14 H1.5 Z</Geometry>
  <Geometry x:Key="IcoClock">M8,1.2 A6.8,6.8 0 1 1 7.99,1.2 Z M8,4 V8 L10.8,9.8</Geometry>
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TileCheck" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip" Value="Select to sell several at once" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="3">
            <Border x:Name="box" Width="16" Height="16" Background="#e60b1119" BorderBrush="{StaticResource Text2}" BorderThickness="1">
              <Path x:Name="mark" Data="{StaticResource IcoCheck}" Stroke="{StaticResource Ink}" StrokeThickness="2" Stretch="Uniform" Margin="3" Visibility="Collapsed" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsChecked}" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="mark" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="Tile" DataType="{x:Type vm:TileViewModel}">
    <Button x:Name="btn" Style="{StaticResource TileButton}" Margin="0,0,8,8" Cursor="Hand"
            Command="{Binding DataContext.Grid.OpenTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
    <c:CutBorder x:Name="tile" Width="120" Height="174" Cut="10" Corners="TopRight" BorderThickness="1"
                 BorderBrush="{Binding RarityHex, Converter={StaticResource HexBrush}}" Background="{StaticResource CardBg}">
      <c:CutBorder.ToolTip>
        <StackPanel>
          <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
          <TextBlock Text="{Binding Wear}" Foreground="{StaticResource Muted}" FontSize="11.5" />
          <TextBlock Foreground="{StaticResource Gold}" FontSize="11.5">
            <Run Text="{Binding PriceText, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Dim}" /><Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{StaticResource Dim}" />
          </TextBlock>
          <TextBlock Text="{Binding SellTip}" Foreground="{StaticResource BlueText}" FontSize="11.5" Margin="0,3,0,0"
                     Visibility="{Binding SellTip, Converter={StaticResource Vis}}" />
        </StackPanel>
      </c:CutBorder.ToolTip>
      <Grid>
        <Rectangle Fill="{Binding RarityHex, Converter={StaticResource HexTint}, ConverterParameter=5a}" />
        <Image c:Img.DecodeWidth="200" c:Img.Icon="{Binding IconUrl}" Width="104" Height="68" Margin="0,16,0,0"
               VerticalAlignment="Top" HorizontalAlignment="Center" Stretch="Uniform" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,9,0" Padding="4,0" BorderThickness="1"
                BorderBrush="#99e6c46e" Background="#cc0b1119" Visibility="{Binding Badge, Converter={StaticResource Vis}}">
          <c:TrackedText Text="{Binding Badge}" FontSize="8.5" FontWeight="SemiBold" Spacing="0.6" Foreground="{StaticResource Warn}" Upper="False" />
        </Border>
        <Border x:Name="sell" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Padding="4,0,5,0" BorderThickness="1"
                BorderBrush="#808fb8ff" Background="#cc0b1119" Visibility="{Binding SellBadge, Converter={StaticResource Vis}}">
          <StackPanel Orientation="Horizontal">
            <Path x:Name="sellIco" Data="{StaticResource IcoLock}" Width="7" Height="8" Stretch="Uniform" Stroke="{StaticResource Late}" StrokeThickness="1.1"
                  Margin="0,0,4,0" VerticalAlignment="Center" />
            <c:TrackedText x:Name="sellText" Text="{Binding SellBadge}" FontSize="8.5" FontWeight="SemiBold" Spacing="0.6" Foreground="{StaticResource Late}" Upper="False" />
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,9">
          <c:TrackedText Text="{Binding RarityText}" FontSize="8.5" FontWeight="Bold" Spacing="1" Foreground="{Binding RarityHex, Converter={StaticResource HexBrush}}" />
          <c:TrackedText Text="{Binding Weapon}" FontSize="8.5" Spacing="0.8" Foreground="#9fb0c6" Margin="0,1,0,0" />
          <c:TrackedText Text="{Binding Skin}" FontSize="12" FontWeight="Bold" Spacing="0.4" Foreground="#f2f5f8" />
          <c:TrackedText Text="{Binding Wear}" FontSize="8.5" Spacing="0.6" Foreground="{StaticResource Dim}" Margin="0,1,0,0" />
          <Grid Margin="0,3,0,0">
            <TextBlock Text="{Binding PriceText}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <c:TrackedText Text="{Binding SourceText}" FontSize="7.5" Spacing="0.8" Foreground="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" />
          </Grid>
        </StackPanel>
        <Rectangle Height="3" VerticalAlignment="Bottom" Fill="{Binding RarityHex, Converter={StaticResource HexBrush}}" />
        <Button x:Name="check" Style="{StaticResource TileCheck}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Visibility="Collapsed"
                Command="{Binding DataContext.Grid.ToggleCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
      </Grid>
    </c:CutBorder>
    </Button>
    <DataTemplate.Triggers>
      <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
        <Setter TargetName="tile" Property="BorderThickness" Value="2" />
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding CanCheck}" Value="True" />
          <Condition Binding="{Binding IsMouseOver, ElementName=tile}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="check" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding CanCheck}" Value="True" />
          <Condition Binding="{Binding SelectMode}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="check" Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding CanCheck}" Value="False" />
          <Condition Binding="{Binding SelectMode}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="tile" Property="Opacity" Value="0.38" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsChecked}" Value="True">
        <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter TargetName="tile" Property="BorderThickness" Value="2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SellKind}" Value="listed">
        <Setter TargetName="sell" Property="BorderBrush" Value="#808fd19a" />
        <Setter TargetName="sellIco" Property="Data" Value="{StaticResource IcoCheck}" />
        <Setter TargetName="sellIco" Property="Stroke" Value="{StaticResource Up}" />
        <Setter TargetName="sellText" Property="Foreground" Value="{StaticResource Up}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SellKind}" Value="pending">
        <Setter TargetName="sell" Property="BorderBrush" Value="#99e6c46e" />
        <Setter TargetName="sellIco" Property="Data" Value="{StaticResource IcoClock}" />
        <Setter TargetName="sellIco" Property="Stroke" Value="{StaticResource Warn}" />
        <Setter TargetName="sellText" Property="Foreground" Value="{StaticResource Warn}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="TileRow" DataType="{x:Type vm:TileRow}">
    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Horizontal}" Focusable="False" />
  </DataTemplate>

  <!-- Status dot: ok / warn / idle / busy -->
  <Style x:Key="Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource Blue}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ok">
        <Setter Property="Fill" Value="{StaticResource Up}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warn">
        <Setter Property="Fill" Value="{StaticResource Accent}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
        <Setter Property="Fill" Value="{StaticResource Dim}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="ok">
        <Setter Property="Foreground" Value="{StaticResource Up}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warn">
        <Setter Property="Foreground" Value="{StaticResource Warn}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- Signed money value: Tag "up" is green, "down" is red -->
  <Style x:Key="TrendValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="up">
        <Setter Property="Foreground" Value="{StaticResource Up}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="down">
        <Setter Property="Foreground" Value="{StaticResource Down}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warn">
        <Setter Property="Foreground" Value="{StaticResource Warn}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- "Sign in to Steam to use this" note with a button to the sign-in step -->
  <ControlTemplate x:Key="SignInNote" TargetType="ContentControl">
    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path Data="{StaticResource IcoInfo}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Warn}" StrokeThickness="1.4" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
          <TextBlock Text="Sign in to Steam to use this" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
          <TextBlock Style="{StaticResource Note}" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Sign in to Steam" VerticalAlignment="Center"
                Command="{Binding DataContext.SignInCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>
    </Border>
  </ControlTemplate>

  <!-- Where to sell: net payout per market after fees -->
  <DataTemplate x:Key="SellCompare" DataType="{x:Type vm:SellCompareViewModel}">
    <StackPanel>
      <c:TrackedText Style="{StaticResource CardHead}" Text="Where to sell" />
      <TextBlock x:Name="headline" Text="{Binding Headline}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                 TextWrapping="Wrap" Margin="0,6,0,8" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="58" />
          <ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <c:TrackedText Style="{StaticResource ColHead}" Text="Market" Margin="8,0,0,0" />
        <c:TrackedText Grid.Column="1" Style="{StaticResource ColHead}" Text="Price" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="2" Style="{StaticResource ColHead}" Text="Fees" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="3" Style="{StaticResource ColHead}" Text="You get" HorizontalAlignment="Right" Margin="0,0,8,0" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="b" BorderBrush="{StaticResource LineFaint}" BorderThickness="1" Padding="8,6" Margin="0,0,0,4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="66" />
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="n" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Payout}" FontSize="10" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding ListPrice}" HorizontalAlignment="Right" FontSize="11.5" />
                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Fee}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Dim}" />
                <TextBlock x:Name="net" Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Net}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource Text}" />
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Best}" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="b" Property="Background" Value="{StaticResource WarnBg}" />
                <Setter TargetName="net" Property="Foreground" Value="{StaticResource Gold}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Note}" Text="{Binding FeeNote}" FontSize="10.5" Margin="0,4,0,0" />
      <TextBlock Style="{StaticResource Note}" Text="{Binding Context}" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                 Visibility="{Binding Context, Converter={StaticResource Vis}}" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasBest}" Value="True">
        <Setter TargetName="headline" Property="Foreground" Value="{StaticResource Gold}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Item details: price, best place to sell, share and alert shortcuts -->
  <DataTemplate x:Key="ItemDetails" DataType="{x:Type vm:ItemDetailsViewModel}">
    <c:CutBorder Style="{StaticResource HudCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="16,12,16,14">
          <Grid Margin="0,0,0,10">
            <c:TrackedText Style="{StaticResource CardHead}" Text="Item details" />
            <Button Style="{StaticResource IconButton}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" ToolTip="Close"
                    AutomationProperties.Name="Close details"
                    Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </Grid>
          <Grid Height="120">
            <Rectangle Fill="{Binding RarityHex, Converter={StaticResource HexTint}, ConverterParameter=40}" />
            <Image c:Img.DecodeWidth="360" c:Img.Icon="{Binding IconUrl}" Margin="14,8" Stretch="Uniform" />
            <Rectangle Height="3" VerticalAlignment="Bottom" Fill="{Binding RarityHex, Converter={StaticResource HexBrush}}" />
          </Grid>
          <c:TrackedText Text="{Binding RarityText}" FontSize="10" FontWeight="Bold" Spacing="1" Margin="0,10,0,0"
                         Foreground="{Binding RarityHex, Converter={StaticResource HexBrush}}" />
          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock Text="{Binding Wear}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding PriceText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Bottom" />
            <c:TrackedText Style="{StaticResource Sub}" Text="{Binding SourceText}" FontSize="10" Margin="10,0,0,4" VerticalAlignment="Bottom" />
          </StackPanel>
          <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Visibility="{Binding IsDrop, Converter={StaticResource Vis}}">
            <Run Text="{Binding How, Mode=OneWay}" /><Run Text=" · at drop " /><Run Text="{Binding AtDrop, Mode=OneWay}" Foreground="{StaticResource Text2}" />
          </TextBlock>
          <TextBlock Style="{StaticResource Note}" Text="{Binding Note}" Foreground="{StaticResource Warn}" Margin="0,6,0,0"
                     Visibility="{Binding Note, Converter={StaticResource Vis}}" />

          <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
          <ContentControl Focusable="False" Content="{Binding Compare}" ContentTemplate="{StaticResource SellCompare}" />

          <WrapPanel Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Share" Margin="0,0,8,6"
                    Tag="{Binding DataContext.ShareKey, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding CanShare, Converter={StaticResource Vis}}"
                    Command="{Binding DataContext.ShareDropCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            <Button Style="{StaticResource GhostButton}" Content="Price alert" Height="32" Margin="0,0,0,6"
                    Command="{Binding DataContext.CreateAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Item}" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </c:CutBorder>
  </DataTemplate>
</ResourceDictionary>
