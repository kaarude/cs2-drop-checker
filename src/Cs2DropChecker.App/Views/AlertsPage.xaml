<UserControl x:Class="Cs2DropChecker.App.Views.AlertsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">
  <UserControl.Resources>
    <Style x:Key="SearchHit" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Padding="10,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,18,24,20">
      <Grid Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <c:TrackedText Style="{StaticResource H1}" Text="Price alerts" VerticalAlignment="Center" />
          <c:TrackedText Style="{StaticResource MutedText}" Text="{Binding Delivery}" Margin="18,4,0,0" />
        </StackPanel>
      </Grid>

      <c:CutBorder Style="{StaticResource HudCard}">
        <StackPanel Margin="16,12,16,14">
          <c:TrackedText Style="{StaticResource CardHead}" Text="New alert" />
          <TextBlock Style="{StaticResource Note}" Margin="0,4,0,12"
                     Text="Each alert fires once when its threshold is crossed, then waits until you reset it or the price moves back. Percent alerts on items measure from the price when you add them. Pick an item from your inventory, or search any CS2 item to watch skins you want to buy." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <c:TrackedText Style="{StaticResource Lbl}" Text="When" FontSize="10" Margin="0,0,0,4" />
            <c:TrackedText Grid.Column="1" Style="{StaticResource Lbl}" Text="Item" FontSize="10" Margin="12,0,0,4" Visibility="{Binding NeedsItem, Converter={StaticResource Vis}}" />
            <c:TrackedText Grid.Column="2" Style="{StaticResource Lbl}" Text="{Binding AmountLabel}" FontSize="10" Margin="12,0,0,4" />
            <!-- SelectedItem binds one way: a two-way binding pushed null back while the page was being swapped out and broke navigation. -->
            <ComboBox Grid.Row="1" Style="{StaticResource HudCombo}" Height="32" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=OneWay}"
                      SelectionChanged="OnKindPicked" />
            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource HudCombo}" Height="32" Margin="12,0,0,0" ItemsSource="{Binding Items}" SelectedItem="{Binding Item, Mode=OneWay}"
                      SelectionChanged="OnItemPicked" Visibility="{Binding NeedsItem, Converter={StaticResource Vis}}" />            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding NeedsItem, Converter={StaticResource Vis}, ConverterParameter=!}"
                       Text="Uses the total value of the watched inventory." />
            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource HudTextBox}" Margin="12,0,0,0" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Add alert" Margin="12,0,0,0" Command="{Binding AddCommand}" />
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource HudTextBox}" Margin="12,8,0,0" FontSize="12.5"
                     Tag="Or search any CS2 item, also ones you don't own"
                     Visibility="{Binding NeedsItem, Converter={StaticResource Vis}}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,0,0" Visibility="{Binding NeedsItem, Converter={StaticResource Vis}}">
              <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False" Background="{StaticResource Field}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SearchHit}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.PickSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MarketHashName}" FontSize="12" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="in inventory" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding Owned, Converter={StaticResource Vis}}" />
                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="12" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Note}" Text="{Binding SearchNote}" Margin="0,6,0,0" Visibility="{Binding SearchNote, Converter={StaticResource Vis}}" />
            </StackPanel>          </Grid>
          <TextBlock Style="{StaticResource StatusText}" Tag="{Binding MessageKind}" Text="{Binding Message}" Margin="0,10,0,0" FontSize="11.5"
                     Visibility="{Binding Message, Converter={StaticResource Vis}}" />
        </StackPanel>
      </c:CutBorder>

      <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
        <StackPanel Margin="16,12,16,12">
          <c:TrackedText Style="{StaticResource CardHead}" Text="Your alerts" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Height="48">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Image c:Img.DecodeWidth="96" c:Img.Icon="{Binding IconUrl}" Width="42" Height="30" Stretch="Uniform" HorizontalAlignment="Left" />
                    <Path Data="{StaticResource IcoInventory}" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                          HorizontalAlignment="Left" Margin="10,0,0,0" Visibility="{Binding IconUrl, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Subject}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Rule2}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Now}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource StatusText}" Tag="{Binding StateKind}" Text="{Binding State}" FontSize="11.5" Margin="0,0,10,0" />
                    <CheckBox Grid.Column="4" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Content="On" FontSize="11.5" Margin="0,0,12,0" />
                    <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="Reset" Height="26" Padding="10,0" Margin="0,0,8,0"
                            ToolTip="Arm the alert again (percent alerts restart from today's price)"
                            Visibility="{Binding Fired, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="{StaticResource IcoTrash}" ToolTip="Delete alert" AutomationProperties.Name="Delete alert"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Note}" Margin="2,8,0,4" Visibility="{Binding Rows.Count, Converter={StaticResource Vis}, ConverterParameter=!}"
                     Text="No alerts yet. Add one above (search to watch items you don't own), or open an item on the Inventory or Drops page and choose Price alert." />
        </StackPanel>
      </c:CutBorder>
    </StackPanel>
  </ScrollViewer>
</UserControl>
