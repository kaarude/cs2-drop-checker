<Window x:Class="Cs2DropChecker.App.Views.BulkSellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        Title="Sell on the Steam Market" Width="760" Height="720" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/app.ico" ShowInTaskbar="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#4d5d79ae" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Path Data="{StaticResource Diamond}" Fill="{StaticResource Accent}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <c:TrackedText Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
        </Grid>
      </Border>

      <!-- Price rule -->
      <Grid Grid.Row="1" Margin="18,14,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <c:TrackedText Style="{StaticResource Lbl}" Text="Price rule for every item" FontSize="10" />
          <TextBlock Style="{StaticResource Note}" Text="{Binding RuleHint}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsSelling, Converter={StaticResource EqBool}, ConverterParameter=False}">
          <RadioButton Style="{StaticResource Seg}" Height="28" Margin="0,0,-1,0" GroupName="rule" Content="Undercut lowest"
                       IsChecked="{Binding Rule, Converter={StaticResource EqBool}, ConverterParameter=undercut}" />
          <RadioButton Style="{StaticResource Seg}" Height="28" Margin="0,0,-1,0" GroupName="rule" Content="Highest buy order"
                       IsChecked="{Binding Rule, Converter={StaticResource EqBool}, ConverterParameter=buy}" />
          <RadioButton Style="{StaticResource Seg}" Height="28" GroupName="rule" Content="Median"
                       IsChecked="{Binding Rule, Converter={StaticResource EqBool}, ConverterParameter=median}" />
        </StackPanel>
      </Grid>

      <!-- Column heads -->
      <Grid Grid.Row="2" Margin="18,14,18,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <c:TrackedText Style="{StaticResource Lbl}" Text="Item" FontSize="10" Margin="62,0,0,0" />
        <c:TrackedText Grid.Column="1" Style="{StaticResource Lbl}" Text="Cheapest" FontSize="10" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="2" Style="{StaticResource Lbl}" Text="Buy order" FontSize="10" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="3" Style="{StaticResource Lbl}" Text="Buyer pays" FontSize="10" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="4" Style="{StaticResource Lbl}" Text="You get" FontSize="10" HorizontalAlignment="Right" />
        <c:TrackedText Grid.Column="5" Style="{StaticResource Lbl}" Text="Status" FontSize="10" HorizontalAlignment="Right" />
      </Grid>

      <Border Grid.Row="3" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding Rows}" Margin="18,4,18,4" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="52" Height="36" Background="{StaticResource CardBg}" BorderBrush="{Binding RarityHex, Converter={StaticResource HexBrush}}" BorderThickness="0,0,0,2">
                        <Image c:Img.DecodeWidth="104" c:Img.Icon="{Binding IconUrl}" Margin="3" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Wear}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding LowestText}" FontSize="12" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding BuyText}" FontSize="12" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding PriceText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding ReceiveText}" FontSize="12.5" Foreground="{StaticResource Up}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="8,0,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Muted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                              <Setter Property="Foreground" Value="{StaticResource Up}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                              <Setter Property="Foreground" Value="{StaticResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                              <Setter Property="Foreground" Value="{StaticResource BlueText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Totals and messages -->
      <StackPanel Grid.Row="4" Margin="18,10,18,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:TrackedText Style="{StaticResource MutedText}" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Bottom" Upper="False" />
          <StackPanel Grid.Column="1" Margin="0,0,24,0">
            <c:TrackedText Style="{StaticResource Lbl}" Text="Buyers pay" FontSize="10" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding TotalBuyer}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <c:TrackedText Style="{StaticResource Lbl}" Text="You get" FontSize="10" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding TotalReceive}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
        <Grid Height="3" Margin="0,10,0,0" Visibility="{Binding StatusText, Converter={StaticResource Vis}}">
          <Rectangle Fill="{StaticResource LineSoft}" />
          <Rectangle Fill="{StaticResource Accent}" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5"
                     Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
            <Rectangle.RenderTransform>
              <ScaleTransform ScaleX="{Binding Progress}" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>
        <Border Margin="0,10,0,0" Padding="14,10" Background="#128fd19a" BorderBrush="#598fd19a" BorderThickness="1"
                Visibility="{Binding DoneText, Converter={StaticResource Vis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Up}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0" />
            <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding DoneText}" />
          </Grid>
        </Border>
      </StackPanel>

      <Border Grid.Row="5" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="18,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Note}" Text="{Binding Error}" Foreground="{StaticResource Down}" FontSize="12"
                       Visibility="{Binding Error, Converter={StaticResource Vis}}" />
            <TextBlock Style="{StaticResource Note}" Text="{Binding StatusText}" Foreground="{StaticResource BlueText}"
                       Visibility="{Binding StatusText, Converter={StaticResource Vis}}" />
            <TextBlock Style="{StaticResource Note}" FontSize="11" Text="Listings go out one at a time. Steam asks you to confirm them in the Steam Mobile app or by email." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource DangerButton}" Content="Stop" Command="{Binding StopCommand}" Height="32" Margin="0,0,8,0"
                    Visibility="{Binding IsSelling, Converter={StaticResource Vis}}" />
            <Button Style="{StaticResource GhostButton}" Content="Close" Command="{Binding CloseCommand}" Height="32" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ListButtonText}" Command="{Binding ListCommand}" IsEnabled="{Binding CanList}" Margin="8,0,0,0"
                    Visibility="{Binding DoneText, Converter={StaticResource Vis}, ConverterParameter=!}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
