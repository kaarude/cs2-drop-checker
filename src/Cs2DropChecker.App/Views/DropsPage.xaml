<UserControl x:Class="Cs2DropChecker.App.Views.DropsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <c:TrackedText Style="{StaticResource H1}" Text="Drops" VerticalAlignment="Center" />
        <c:TrackedText Style="{StaticResource MutedText}" Text="{Binding Summary}" Margin="18,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource GhostButton}" Content="Export CSV" Height="32" Margin="0,0,10,0"
              ToolTip="Save the rows shown below (current filter and search) as a CSV file for Excel or Google Sheets"
              Command="{Binding DataContext.ExportDropsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Button Style="{StaticResource GhostButton}" Content="Share last drop" Height="32" Margin="0,0,10,0"
              ToolTip="Copy a card of your newest drop to the clipboard and save it as PNG"
              Command="{Binding DataContext.ShareLastDropCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Button Style="{StaticResource PrimaryButton}" Content="Refresh now"
              Tag="{Binding DataContext.RefreshKey, RelativeSource={RelativeSource AncestorType=Window}}"
              Command="{Binding DataContext.RefreshNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
    <c:CutBorder Style="{StaticResource HudCard}">
      <Grid Margin="16,12,16,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
            <c:TrackedText Style="{StaticResource CardHead}" Text="History" Margin="0,0,16,0" />
            <ItemsControl ItemsSource="{Binding Filters}" ItemsPanel="{StaticResource Horizontal}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource Chip}" Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                               Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBox Grid.Column="1" Style="{StaticResource HudTextBox}" Tag="Search items" Width="220" Margin="10,0,0,0" Height="28" FontSize="12" HorizontalAlignment="Right"
                   Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
        </Grid>
        <ContentControl Grid.Row="1" Template="{StaticResource DropHeader}" Focusable="False" Margin="0,0,10,0" />
        <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DropRow}" />
        <TextBlock Grid.Row="2" Style="{StaticResource Note}" Margin="4,16" VerticalAlignment="Top"
                   Visibility="{Binding Rows, Converter={StaticResource Vis}, ConverterParameter=!}"
                   Text="No items here yet. The app records weekly drops, case openings, trade-ups and purchases from the moment it starts watching." />
      </Grid>
    </c:CutBorder>
    <!-- Floats over the price columns: the table's fixed columns don't fit next to the panel. -->
    <Border HorizontalAlignment="Right" Background="{StaticResource Bg}" Padding="14,0,0,0" Visibility="{Binding Details, Converter={StaticResource Vis}}">
      <ContentControl Width="340" Focusable="False" Content="{Binding Details}" ContentTemplate="{StaticResource ItemDetails}" />
    </Border>
    </Grid>
  </Grid>
</UserControl>
