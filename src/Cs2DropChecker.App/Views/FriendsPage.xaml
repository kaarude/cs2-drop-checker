<UserControl x:Class="Cs2DropChecker.App.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,18,24,20">
      <Grid Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <c:TrackedText Style="{StaticResource H1}" Text="Friends" VerticalAlignment="Center" />
          <c:TrackedText Style="{StaticResource MutedText}" Text="{Binding WeekText}" Margin="18,4,0,0" />
        </StackPanel>
        <Button Style="{StaticResource GhostButton}" Content="Check friends now" Height="32" HorizontalAlignment="Right" Command="{Binding RefreshNowCommand}"
                ToolTip="Checks each followed friend's public inventory, a few seconds apart to stay inside Steam's limits" />
      </Grid>

      <c:CutBorder Style="{StaticResource HudCard}">
        <StackPanel Margin="16,12,16,12">
          <Grid Margin="0,0,0,6">
            <c:TrackedText Style="{StaticResource CardHead}" Text="Leaderboard" />
            <c:TrackedText Style="{StaticResource MutedText}" Text="{Binding RefreshText}" HorizontalAlignment="Right" FontSize="10" />
          </Grid>
          <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Height="28">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" MinWidth="170" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <c:TrackedText Style="{StaticResource ColHead}" Text="#" Margin="8,0,0,0" />
              <c:TrackedText Grid.Column="1" Style="{StaticResource ColHead}" Text="Player" />
              <c:TrackedText Grid.Column="2" Style="{StaticResource ColHead}" Text="Best drop this week" />
              <c:TrackedText Grid.Column="3" Style="{StaticResource ColHead}" Text="Drops this week" HorizontalAlignment="Right" />
              <c:TrackedText Grid.Column="4" Style="{StaticResource ColHead}" Text="Inventory" HorizontalAlignment="Right" />
              <c:TrackedText Grid.Column="5" Style="{StaticResource ColHead}" Text="Case P&amp;L" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding LeaderRows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="row" BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Height="46">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" MinWidth="170" />
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="30" Height="30" Background="#1a2433" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                        <Image c:Img.DecodeWidth="64" c:Img.Icon="{Binding AvatarUrl}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <TextBlock x:Name="status" Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource Dim}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Best}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding BestHex, Converter={StaticResource HexBrush}}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding BestValue}" FontSize="10.5" Foreground="{StaticResource Gold}" Visibility="{Binding BestValue, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Week}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding WeekSub}" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding Inventory}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Style="{StaticResource TrendValue}" Tag="{Binding CaseTrend}" Text="{Binding CaseNet}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding CaseSub}" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border Grid.Column="2" Grid.ColumnSpan="4" Background="{StaticResource Bg}" Visibility="{Binding IsPrivate, Converter={StaticResource Vis}}">
                      <TextBlock Text="Private inventory · nothing to compare" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsYou}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource WarnBg}" />
                    <Setter TargetName="status" Property="Foreground" Value="{StaticResource Accent}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource Muted}" />
                    <Setter TargetName="status" Property="Foreground" Value="{StaticResource Warn}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0" Visibility="{Binding HasFriends, Converter={StaticResource Vis}, ConverterParameter=!}"
                     Text="Add friends below to compare. Any public Steam profile works." />
          <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0"
                     Text="Your case P&amp;L is exact. Friends' case P&amp;L is an estimate: the app sees a case leave their public inventory and an item arrive, and prices both when it notices. Friends' drops count from the first check after you add them." />
        </StackPanel>
      </c:CutBorder>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <c:CutBorder Style="{StaticResource HudCard}">
          <StackPanel Margin="16,12,16,14">
            <c:TrackedText Style="{StaticResource CardHead}" Text="Add a friend" />
            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,10" Text="Paste a profile link, custom URL name or SteamID64. Works without signing in; the inventory has to be public." />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Style="{StaticResource HudTextBox}" Tag="steamcommunity.com/id/… or 7656119…" Text="{Binding AddInput, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add" Margin="10,0,0,0" Command="{Binding AddCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource StatusText}" Tag="{Binding AddKind}" Text="{Binding AddMessage}" Margin="0,8,0,0" FontSize="11.5"
                       Visibility="{Binding AddMessage, Converter={StaticResource Vis}}" />
            <c:TrackedText Style="{StaticResource Lbl}" Text="Following" Margin="0,14,0,4" FontSize="10" Visibility="{Binding HasFriends, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Friends}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Height="44">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="28" Height="28" Background="#1a2433" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Center">
                        <Image c:Img.DecodeWidth="64" c:Img.Icon="{Binding AvatarUrl}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding Tracked}" Content="Compare" FontSize="11.5" Margin="0,0,10,0"
                                ToolTip="Show on the leaderboard and keep checking their inventory" />
                      <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{StaticResource IcoTrash}" ToolTip="Remove friend" AutomationProperties.Name="Remove friend"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:CutBorder>

        <c:CutBorder Grid.Column="2" Style="{StaticResource HudCard}">
          <StackPanel Margin="16,12,16,14">
            <c:TrackedText Style="{StaticResource CardHead}" Text="Steam friends" />
            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,10" Text="Pick friends straight from your Steam friends list. Uses the Steam sign-in already stored in the app; nothing is sent anywhere else." />
            <ContentControl Template="{StaticResource SignInNote}" Focusable="False" Content="Import your friends list from Steam. Adding friends by profile link works without it."
                            Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}" />
            <StackPanel Visibility="{Binding SignedIn, Converter={StaticResource Vis}}">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Load friends list" Command="{Binding LoadSteamCommand}" />
                <Button Style="{StaticResource LinkButton}" Content="Select all" Margin="14,0,0,0" Command="{Binding SelectAllCommand}" CommandParameter="true"
                        Visibility="{Binding SteamFriends.Count, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource LinkButton}" Content="Select none" Margin="10,0,0,0" Command="{Binding SelectAllCommand}" CommandParameter="false"
                        Visibility="{Binding SteamFriends.Count, Converter={StaticResource Vis}}" />
              </StackPanel>
              <TextBlock Style="{StaticResource StatusText}" Tag="{Binding SteamKind}" Text="{Binding SteamMessage}" Margin="0,8,0,0" FontSize="11.5"
                         Visibility="{Binding SteamMessage, Converter={StaticResource Vis}}" />
              <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding SteamFriends}" MaxHeight="340" Margin="0,8,0,0"
                       Visibility="{Binding SteamFriends.Count, Converter={StaticResource Vis}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,0,1" Height="38">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" />
                        <Border Grid.Column="1" Width="24" Height="24" Margin="12,0,10,0" Background="#1a2433" VerticalAlignment="Center">
                          <Image c:Img.DecodeWidth="48" c:Img.Icon="{Binding AvatarUrl}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Style="{StaticResource PrimaryButton}" Content="Save selection" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding SaveSteamCommand}"
                      Visibility="{Binding SteamFriends.Count, Converter={StaticResource Vis}}" />
            </StackPanel>
          </StackPanel>
        </c:CutBorder>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
