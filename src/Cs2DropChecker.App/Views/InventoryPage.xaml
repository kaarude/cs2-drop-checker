<UserControl x:Class="Cs2DropChecker.App.Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
             xmlns:v="clr-namespace:Cs2DropChecker.App.Views">
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <c:TrackedText Style="{StaticResource H1}" Text="Inventory" VerticalAlignment="Center" />
      <Button Style="{StaticResource PrimaryButton}" Content="Refresh now" HorizontalAlignment="Right"
              Tag="{Binding DataContext.RefreshKey, RelativeSource={RelativeSource AncestorType=Window}}"
              Command="{Binding DataContext.RefreshNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Grid>
    <v:ProfileInventoryView Grid.Row="1" Visibility="{Binding HasData, Converter={StaticResource Vis}}" />
    <c:CutBorder Grid.Row="1" Style="{StaticResource HudCard}" VerticalAlignment="Top" Visibility="{Binding HasData, Converter={StaticResource Vis}, ConverterParameter=!}">
      <StackPanel Margin="18,16">
        <c:TrackedText Style="{StaticResource CardHead}" Text="{Binding StatusLine}" />
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                   Text="The inventory loads on the first check. If it stays empty, make sure the Steam inventory is public (Steam > Profile > Edit Profile > Privacy Settings > Inventory: Public), or sign in under Settings." />
      </StackPanel>
    </c:CutBorder>
  </Grid>
</UserControl>
