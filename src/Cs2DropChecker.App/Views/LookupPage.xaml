<UserControl x:Class="Cs2DropChecker.App.Views.LookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
             xmlns:v="clr-namespace:Cs2DropChecker.App.Views">
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <c:TrackedText Style="{StaticResource H1}" Text="Player lookup" VerticalAlignment="Center" />
      <c:TrackedText Style="{StaticResource MutedText}" Text="One-time · nothing is saved" HorizontalAlignment="Right" FontSize="10.5" />
    </Grid>
    <c:CutBorder Grid.Row="1" Style="{StaticResource HudCard}" Margin="0,0,0,14">
      <StackPanel Margin="14,12,14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Query" Style="{StaticResource HudTextBox}" Tag="Profile link, SteamID64 or custom name" Height="34"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnQueryKey" />
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Look up" Height="34" Margin="8,0,0,0"
                  Command="{Binding LookupCommand}" IsEnabled="{Binding Busy, Converter={x:Static v:Not.Instance}}" />
          <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Clear" Height="34" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
          <TextBlock Style="{StaticResource Note}" Text="Paste a profile link, SteamID64 or custom name." />
          <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Up}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" Margin="16,0,6,0" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Note}" Text="Not saved to history. Only public inventories. Cleared when you leave this tab." />
        </StackPanel>
        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Warn}" Margin="2,8,0,0" Text="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource Vis}}" />
        <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource BlueText}" Margin="2,8,0,0" Text="Loading inventory…"
                   Visibility="{Binding Busy, Converter={StaticResource Vis}}" />
      </StackPanel>
    </c:CutBorder>
    <v:ProfileInventoryView Grid.Row="2" Visibility="{Binding HasData, Converter={StaticResource Vis}}" />
  </Grid>
</UserControl>
