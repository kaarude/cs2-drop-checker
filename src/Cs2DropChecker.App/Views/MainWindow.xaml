<Window x:Class="Cs2DropChecker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        xmlns:v="clr-namespace:Cs2DropChecker.App.Views"
        xmlns:vm="clr-namespace:Cs2DropChecker.App.ViewModels"
        Title="CS2 Drop Checker" Width="1260" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
      <v:OverviewPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DropsViewModel}">
      <v:DropsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
      <v:InventoryPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LookupViewModel}">
      <v:LookupPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <v:SettingsPage />
    </DataTemplate>
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NavText" TargetType="c:TrackedText">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Spacing" Value="1.6" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Foot" TargetType="c:TrackedText">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Spacing" Value="1.1" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="#2a3a52" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Path Data="{StaticResource Diamond}" Fill="{StaticResource Accent}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <c:TrackedText Text="CS2 Drop Checker" FontSize="12" FontWeight="Bold" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}" />
            <Border Background="{StaticResource StatusBg}" Padding="9,3,10,3" Margin="22,0,0,0" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTipService.InitialShowDelay="300">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTip}" Value="">
                      <Setter Property="ToolTip" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                  <Setter Property="ToolTip" Value="{Binding StatusTip}" />
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource Dot}" Tag="{Binding StatusKind}" />
                <c:TrackedText Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Spacing="1.3" Foreground="{StaticResource Text2}" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WinButton}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
              <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource WinButton}" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
              <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CloseButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="212" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
          <DockPanel Margin="0,10,0,14">
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,12,0">
              <c:TrackedText Style="{StaticResource Foot}" Text="{Binding FootId}" Upper="False" />
              <c:TrackedText Style="{StaticResource Foot}" Text="{Binding FootPrices}" />
              <c:TrackedText Style="{StaticResource Foot}" Text="{Binding FootStartup}" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Overview" IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Overview}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IcoOverview}" />
                  <c:TrackedText Style="{StaticResource NavText}" Text="Overview" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Drops" IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Drops}"
                           HorizontalContentAlignment="Stretch">
                <Grid Width="170">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource IcoDrops}" />
                    <c:TrackedText Style="{StaticResource NavText}" Text="Drops" />
                  </StackPanel>
                  <Border Background="{StaticResource Accent}" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding NewDrops, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding NewDrops}" Foreground="{StaticResource Ink}" FontSize="10.5" FontWeight="Bold" />
                  </Border>
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Inventory" IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Inventory}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IcoInventory}" />
                  <c:TrackedText Style="{StaticResource NavText}" Text="Inventory" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Lookup" IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Lookup}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IcoLookup}" />
                  <c:TrackedText Style="{StaticResource NavText}" Text="Lookup" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavItem}" AutomationProperties.Name="Settings" IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Settings}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IcoSettings}" />
                  <c:TrackedText Style="{StaticResource NavText}" Text="Settings" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </DockPanel>
        </Border>
        <ContentPresenter Grid.Column="1" Content="{Binding Current}" />
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:TrackedText Text="{Binding LastPollText}" FontSize="10" Spacing="1.1" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
          <c:TrackedText Grid.Column="1" Text="{Binding PricesText}" FontSize="10" Spacing="1.1" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="28,0,16,0" />
          <c:TrackedText Grid.Column="2" Text="Prices ignore stickers, charms, float and Doppler phase" FontSize="10" Spacing="1.1" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
