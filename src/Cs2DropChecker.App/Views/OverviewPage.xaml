<UserControl x:Class="Cs2DropChecker.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,18,24,20">
      <Grid Margin="0,0,0,14">
        <c:TrackedText Style="{StaticResource H1}" Text="Overview" VerticalAlignment="Center" />
        <Button Style="{StaticResource PrimaryButton}" Content="Refresh now" HorizontalAlignment="Right"
                Tag="{Binding DataContext.RefreshKey, RelativeSource={RelativeSource AncestorType=Window}}"
                Command="{Binding DataContext.RefreshNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>

      <UniformGrid Columns="4" Margin="0,0,-12,0">
        <c:CutBorder Style="{StaticResource HudCard}" Margin="0,0,12,0">
          <Grid>
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}" />
            <StackPanel Margin="15,13,15,12">
              <c:TrackedText Style="{StaticResource Lbl}" Text="Inventory value" FontSize="10.5" />
              <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ValueText}" Margin="0,4,0,1" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding ValueSub}" FontSize="10" />
            </StackPanel>
          </Grid>
        </c:CutBorder>
        <c:CutBorder Style="{StaticResource HudCard}" Margin="0,0,12,0">
          <Grid>
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}" />
            <StackPanel Margin="15,13,15,12">
              <c:TrackedText Style="{StaticResource Lbl}" Text="New items · 30 days" FontSize="10.5" />
              <TextBlock Style="{StaticResource KpiValue}" Text="{Binding NewCount}" Margin="0,4,0,1" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding NewSub}" FontSize="10" Foreground="{StaticResource Up}" />
            </StackPanel>
          </Grid>
        </c:CutBorder>
        <c:CutBorder Style="{StaticResource HudCard}" Margin="0,0,12,0">
          <Grid>
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}" />
            <StackPanel Margin="15,13,15,12">
              <c:TrackedText Style="{StaticResource Lbl}" Text="Best drop" FontSize="10.5" />
              <Grid Height="36" Margin="0,4,0,1">
                <c:TrackedText Text="{Binding BestName}" FontSize="17" FontWeight="Bold" Spacing="0.8" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
              </Grid>
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding BestSub}" FontSize="10" />
            </StackPanel>
          </Grid>
        </c:CutBorder>
        <c:CutBorder Style="{StaticResource HudCard}" Margin="0,0,12,0">
          <Grid>
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}" />
            <StackPanel Margin="15,13,15,12">
              <c:TrackedText Style="{StaticResource Lbl}" Text="{Binding WeeklyLabel}" FontSize="10.5" />
              <TextBlock Style="{StaticResource KpiValue}" Text="{Binding WeeklyCount}" Margin="0,4,0,1" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding WeeklySub}" FontSize="10" />
            </StackPanel>
          </Grid>
        </c:CutBorder>
      </UniformGrid>

      <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
        <Grid Margin="16,12,16,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="250" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <c:TrackedText Style="{StaticResource CardHead}" Text="Inventory value over time" />
            <c:TrackedText Style="{StaticResource MutedText}" Text="Dots mark new items" Margin="14,0,0,0" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton Style="{StaticResource Seg}" Content="7D" GroupName="range" IsChecked="{Binding Range, Converter={StaticResource EqBool}, ConverterParameter=7D}" />
            <RadioButton Style="{StaticResource Seg}" Content="30D" GroupName="range" IsChecked="{Binding Range, Converter={StaticResource EqBool}, ConverterParameter=30D}" />
            <RadioButton Style="{StaticResource Seg}" Content="90D" GroupName="range" IsChecked="{Binding Range, Converter={StaticResource EqBool}, ConverterParameter=90D}" />
            <RadioButton Style="{StaticResource Seg}" Content="1Y" GroupName="range" IsChecked="{Binding Range, Converter={StaticResource EqBool}, ConverterParameter=1Y}" />
            <RadioButton Style="{StaticResource Seg}" Content="All" GroupName="range" IsChecked="{Binding Range, Converter={StaticResource EqBool}, ConverterParameter=All}" />
          </StackPanel>
          <c:ValueChart Grid.Row="1" Margin="0,8,0,0" Points="{Binding Points}" Markers="{Binding Markers}" Currency="{Binding Currency}" From="{Binding From}" />
        </Grid>
      </c:CutBorder>

      <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
        <StackPanel Margin="16,12,16,8">
          <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <c:TrackedText Style="{StaticResource CardHead}" Text="Recent drops" />
              <c:TrackedText Style="{StaticResource MutedText}" Text="Price when it arrived vs. now" Margin="14,0,0,0" FontSize="10" />
            </StackPanel>
            <Button Style="{StaticResource LinkButton}" Content="{Binding ViewAllText}" HorizontalAlignment="Right"
                    Command="{Binding DataContext.ViewAllDropsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </Grid>
          <ContentControl Template="{StaticResource DropHeader}" Focusable="False" />
          <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource DropRow}" Focusable="False" />
          <TextBlock Style="{StaticResource Note}" Margin="4,14,4,10" Visibility="{Binding TotalDrops, Converter={StaticResource Vis}, ConverterParameter=!}"
                     Text="Nothing new yet. Weekly drops, case openings, trade-ups and purchases show up here as soon as the app sees them in your inventory." />
        </StackPanel>
      </c:CutBorder>
    </StackPanel>
  </ScrollViewer>
</UserControl>
