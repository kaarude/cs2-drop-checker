<UserControl x:Class="Cs2DropChecker.App.Views.ProfileInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <c:CutBorder Style="{StaticResource HudCard}">
      <Grid>
        <Grid Margin="16,14,18,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="58" Height="58" Background="#1a2433" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Top">
            <Grid>
              <TextBlock Text="{Binding Initials}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="Avatar" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
            <c:TrackedText Text="{Binding Name}" FontSize="20" FontWeight="Bold" Spacing="1.6" Upper="True" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding IdLine}" FontSize="10.5" Upper="False" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding StatusLine}" FontSize="10.5" Foreground="{StaticResource Up}" Margin="14,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Note}" Text="{Binding HiddenNote}" Margin="0,5,0,0" MaxWidth="520" HorizontalAlignment="Left"
                       Visibility="{Binding HiddenNote, Converter={StaticResource Vis}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,28,0">
              <c:TrackedText Style="{StaticResource Lbl}" Text="Inventory value" FontSize="10" />
              <TextBlock Text="{Binding ValueText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Gold}" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding ValueSource}" FontSize="10" />
            </StackPanel>
            <StackPanel Margin="0,0,28,0">
              <c:TrackedText Style="{StaticResource Lbl}" Text="Items" FontSize="10" />
              <TextBlock Text="{Binding ItemsText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Text}" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding PricedText}" FontSize="10" />
            </StackPanel>
            <StackPanel MaxWidth="220">
              <c:TrackedText Style="{StaticResource Lbl}" Text="Most valuable" FontSize="10" />
              <TextBlock Text="{Binding BestName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding BestPrice}" FontSize="11" Foreground="{StaticResource Gold}" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <c:SegmentBar Segments="{Binding Groups}" Height="4" Gap="3" VerticalAlignment="Bottom" />
      </Grid>
    </c:CutBorder>

    <c:CutBorder Grid.Row="1" Style="{StaticResource HudCard}" Margin="0,14,0,0">
      <Grid Margin="16,12,8,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,8,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:TrackedText Style="{StaticResource CardHead}" Text="Items" Margin="0,0,16,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Grid.Filters}" ItemsPanel="{StaticResource Wrap}" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource Chip}" Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2,6,2"
                             Command="{Binding DataContext.Grid.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Grid.Column="2" Style="{StaticResource HudTextBox}" Tag="Search" Width="170" Height="28" FontSize="12" Margin="10,0,8,0"
                   Text="{Binding Grid.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
          <ComboBox Grid.Column="3" Style="{StaticResource HudCombo}" Width="140" Height="28" ItemsSource="{Binding Grid.SortOptions}"
                    SelectedItem="{Binding Grid.Sort}" />
        </Grid>
        <ListBox x:Name="Tiles" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Grid.Rows}" ItemTemplate="{StaticResource TileRow}" />
        <Grid Grid.Row="2" Margin="0,8,8,0">
          <TextBlock Style="{StaticResource Note}" Text="Base prices ignore stickers, charms, float and Doppler phase · flagged items may be worth more" />
          <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Right">
            <Run Text="Showing " /><Run Text="{Binding Grid.Shown, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Grid.Total, Mode=OneWay}" />
          </TextBlock>
        </Grid>
      </Grid>
    </c:CutBorder>
  </Grid>
</UserControl>
