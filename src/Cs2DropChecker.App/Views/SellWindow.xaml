<Window x:Class="Cs2DropChecker.App.Views.SellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        Title="Sell on the Steam Market" Width="620" Height="820" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/app.ico" ShowInTaskbar="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#4d5d79ae" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Path Data="{StaticResource Diamond}" Fill="{StaticResource Accent}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <c:TrackedText Text="Sell on the Steam Market" FontSize="12" FontWeight="SemiBold" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <c:TrackedText Text="{Binding WalletText}" FontSize="10" Spacing="1.2" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,14,0" Upper="False" />
            <Button Style="{StaticResource CloseButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="18,16,18,16">
          <!-- Item -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="124" Height="84" Background="{StaticResource CardBg}" BorderBrush="{Binding RarityHex, Converter={StaticResource HexBrush}}" BorderThickness="0,0,0,3">
              <Grid>
                <Rectangle Fill="{Binding RarityHex, Converter={StaticResource HexTint}, ConverterParameter=5a}" />
                <Image c:Img.DecodeWidth="240" c:Img.Icon="{Binding IconUrl}" Margin="8,6" Stretch="Uniform" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <c:TrackedText Text="{Binding RarityLine}" FontSize="10" FontWeight="Bold" Spacing="1.3" Foreground="{Binding RarityHex, Converter={StaticResource HexBrush}}" />
              <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              <TextBlock Text="{Binding Wear}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
              <TextBlock Style="{StaticResource Note}" Text="{Binding ValueWarning}" Foreground="{StaticResource Warn}" Margin="0,4,0,0"
                         Visibility="{Binding ValueWarning, Converter={StaticResource Vis}}" />
            </StackPanel>
          </Grid>

          <!-- Price history -->
          <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
            <StackPanel Margin="14,10,12,8">
              <DockPanel>
                <c:TrackedText DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding ReferenceText}" FontSize="10" Upper="False" />
                <c:TrackedText Style="{StaticResource Lbl}" Text="Steam sale price · 30 days" FontSize="10" />
              </DockPanel>
              <c:PriceChart Height="124" Margin="0,8,0,0" Points="{Binding History}" Currency="{Binding Currency}" Marker="{Binding Marker}" EmptyText="{Binding HistoryNote}" />
            </StackPanel>
          </c:CutBorder>

          <!-- Market now -->
          <UniformGrid Columns="3" Margin="2,14,0,0">
            <StackPanel>
              <c:TrackedText Style="{StaticResource Lbl}" Text="Cheapest listing" FontSize="10" />
              <TextBlock Text="{Binding LowestText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,4,0,0" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding LowestSub}" FontSize="10" />
            </StackPanel>
            <StackPanel>
              <c:TrackedText Style="{StaticResource Lbl}" Text="Highest buy order" FontSize="10" />
              <TextBlock Text="{Binding BuyText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,4,0,0" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding BuySub}" FontSize="10" />
            </StackPanel>
            <StackPanel>
              <c:TrackedText Style="{StaticResource Lbl}" Text="{Binding MedianTitle}" FontSize="10" />
              <TextBlock Text="{Binding MedianText}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,4,0,0" />
              <c:TrackedText Style="{StaticResource Sub}" Text="{Binding MedianSub}" FontSize="10" />
            </StackPanel>
          </UniformGrid>

          <!-- Where to sell -->
          <c:CutBorder Style="{StaticResource HudCard}" Margin="0,16,0,0">
            <ContentControl Margin="14,10,12,10" Focusable="False" Content="{Binding Compare}" ContentTemplate="{StaticResource SellCompare}" />
          </c:CutBorder>

          <!-- Price choice -->
          <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowSell, Converter={StaticResource Vis}}">
            <c:TrackedText Style="{StaticResource Lbl}" Text="Your price" FontSize="10" />
            <ItemsControl ItemsSource="{Binding Choices}" Margin="0,8,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource ChoiceRow}" IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding Available}"
                               Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="124" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <c:TrackedText Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Spacing="1.2" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding ReceiveText}" FontSize="11.5" Foreground="{StaticResource Up}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <RadioButton Style="{StaticResource ChoiceRow}" IsChecked="{Binding Custom.IsSelected, Mode=OneWay}"
                         Command="{Binding SelectCommand}" CommandParameter="{Binding Custom}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <c:TrackedText Text="{Binding Custom.Label}" FontSize="12" FontWeight="SemiBold" Spacing="1.2" Foreground="{StaticResource Text}" />
                  <TextBlock Text="{Binding Custom.Hint}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <StackPanel>
                    <c:TrackedText Text="Buyer pays" FontSize="9" Spacing="1.2" Foreground="{StaticResource Label}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HudTextBox}" Width="104" Height="30" FontSize="13" Tag="0.00" GotKeyboardFocus="OnCustomFocus"
                             Text="{Binding CustomBuyer, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                  </StackPanel>
                  <StackPanel Margin="8,0,0,0">
                    <c:TrackedText Text="You get" FontSize="9" Spacing="1.2" Foreground="{StaticResource Label}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HudTextBox}" Width="104" Height="30" FontSize="13" Tag="0.00" GotKeyboardFocus="OnCustomFocus"
                             Text="{Binding CustomReceive, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </RadioButton>

            <Grid Margin="2,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="13">
                  <Run Text="Buyer pays " Foreground="{StaticResource Muted}" /><Run Text="{Binding BuyerPaysText, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" Text="{Binding FeeText}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <c:TrackedText Style="{StaticResource Lbl}" Text="You get" FontSize="10" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ReceiveText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource WarnLine}" Margin="0,8,0,0" Focusable="False" />
          </StackPanel>

          <!-- Listed, protected or not marketable -->
          <Border Margin="0,18,0,0" Padding="14,12" Background="#0f1826" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  Visibility="{Binding ShowInfo, Converter={StaticResource Vis}}">
            <StackPanel>
              <c:TrackedText Text="{Binding InfoTitle}" FontSize="13" FontWeight="SemiBold" Spacing="1.6" Foreground="{StaticResource BlueText}" />
              <TextBlock Style="{StaticResource Body}" Text="{Binding InfoText}" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding ShowListed, Converter={StaticResource Vis}}">
                <Button Style="{StaticResource DangerButton}" Content="{Binding CancelText}" Command="{Binding CancelListingCommand}"
                        Visibility="{Binding CanCancelListing, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource GhostButton}" Content="Check again" Command="{Binding RefreshListingCommand}"
                        Visibility="{Binding CanCancelListing, Converter={StaticResource Vis}, ConverterParameter=!}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Done -->
          <Border Margin="0,18,0,0" Padding="16,14" Background="#128fd19a" BorderBrush="#598fd19a" BorderThickness="1"
                  Visibility="{Binding ShowDone, Converter={StaticResource Vis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Up}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,14,0" />
              <StackPanel Grid.Column="1">
                <c:TrackedText Text="{Binding DoneTitle}" FontSize="14" FontWeight="Bold" Spacing="1.6" Foreground="{StaticResource Up}" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding DoneText}" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="18,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Note}" Text="{Binding Error}" Foreground="{StaticResource Down}" FontSize="12"
                       Visibility="{Binding Error, Converter={StaticResource Vis}}" />
            <TextBlock Style="{StaticResource Note}" Text="{Binding StatusText}" Foreground="{StaticResource BlueText}"
                       Visibility="{Binding StatusText, Converter={StaticResource Vis}}" />
            <TextBlock Style="{StaticResource Note}" FontSize="11" Text="Steam asks you to confirm each listing in the Steam Mobile app or by email."
                       Visibility="{Binding ShowSell, Converter={StaticResource Vis}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Content="Close" Command="{Binding CloseCommand}" Height="32" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ListButtonText}" Command="{Binding ListCommand}" IsEnabled="{Binding CanList}"
                    Margin="8,0,0,0" Visibility="{Binding ShowSell, Converter={StaticResource Vis}}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
