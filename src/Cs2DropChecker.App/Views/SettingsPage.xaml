<UserControl x:Class="Cs2DropChecker.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
             xmlns:v="clr-namespace:Cs2DropChecker.App.Views">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="c:TrackedText" BasedOn="{StaticResource Lbl}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Width" Value="140" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="SideNote" TargetType="TextBlock" BasedOn="{StaticResource Note}">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Chevron" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,18,24,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <c:TrackedText Style="{StaticResource H1}" Text="Settings" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <c:TrackedText Text="{Binding SavedText}" FontSize="11" FontWeight="SemiBold" Spacing="1.4" Foreground="{StaticResource Up}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <Button Style="{StaticResource GhostButton}" Content="Discard" Command="{Binding DiscardCommand}" Height="32" Margin="0,0,10,0"
                Visibility="{Binding IsDirty, Converter={StaticResource Vis}}" />
        <Button Style="{StaticResource PrimaryButton}" Content="Save changes" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column -->
        <StackPanel>
          <c:CutBorder Style="{StaticResource HudCard}">
            <StackPanel Margin="16,12,16,4">
              <c:TrackedText Style="{StaticResource CardHead}" Text="Steam account" Margin="0,0,0,14" />
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Steam profile" />
                <TextBox Style="{StaticResource HudTextBox}" Width="210" Height="30" FontSize="12.5" Tag="Link, SteamID64 or name"
                         Text="{Binding SteamInput, UpdateSourceTrigger=PropertyChanged}" />
                <DockPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <Ellipse DockPanel.Dock="Left" Style="{StaticResource Dot}" Tag="{Binding AccountKind}" Margin="0,0,7,0" />
                  <TextBlock Style="{StaticResource StatusText}" Tag="{Binding AccountKind}" Text="{Binding AccountStatus}" FontSize="11.5" LineHeight="15" />
                </DockPanel>
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Steam sign-in" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Sign out" Height="28" Command="{Binding SignOutCommand}"
                        Visibility="{Binding SignedIn, Converter={StaticResource Vis}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Sign in" Height="28" Command="{Binding SignInCommand}"
                        Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}" />
                <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                  <Ellipse DockPanel.Dock="Left" Style="{StaticResource Dot}" Tag="{Binding SignInKind}" Margin="0,0,7,0" />
                  <TextBlock Style="{StaticResource StatusText}" Tag="{Binding SignInKind}" Text="{Binding SignInText}" FontSize="11.5" LineHeight="15" />
                </DockPanel>
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Watch" />
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WatchOnlyWhileCs2}" Content="Poll only while cs2.exe is running" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Poll interval" />
                <ComboBox Style="{StaticResource HudCombo}" Width="100" ItemsSource="{Binding PollOptions}" SelectedItem="{Binding PollInterval}" />
                <TextBlock Style="{StaticResource SideNote}" Text="Minimum 2 min. Slows down on its own if Steam rate-limits." />
              </DockPanel>
            </StackPanel>
          </c:CutBorder>

          <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
            <StackPanel Margin="16,12,16,12">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <c:TrackedText Style="{StaticResource CardHead}" Text="Prices" />
                <c:TrackedText Style="{StaticResource MutedText}" Text="Drag to reorder · first source with a price wins" Margin="14,0,0,0" FontSize="10" />
              </StackPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Currency" />
                <ComboBox Style="{StaticResource HudCombo}" Width="100" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" />
                <TextBlock Style="{StaticResource SideNote}" Text="{Binding CurrencyNote}" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="src" Background="#0affffff" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Margin="0,0,0,6" Padding="6,7,10,7"
                            AllowDrop="True" Drop="OnSourceDrop" DragOver="OnSourceDragOver">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Background="Transparent" Cursor="SizeAll" Width="18" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" ToolTip="Drag to reorder">
                          <Path Data="{StaticResource IcoGrip}" Stroke="{StaticResource Dim}" StrokeThickness="1.6" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Index}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" Width="18" Margin="6,0,6,0" VerticalAlignment="Center" />
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Margin="10,0,0,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                          <Button Style="{StaticResource Chevron}" Content="M0,4 L4,0 L8,4" ToolTip="Move up"
                                  Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                          <Button Style="{StaticResource Chevron}" Content="M0,0 L4,4 L8,0" ToolTip="Move down"
                                  Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#05ffffff" BorderBrush="{StaticResource LineFaint}" BorderThickness="1" Padding="6,7,10,7" Opacity="0.55"
                      ToolTip="CSFloat needs a personal API key. Support for it is planned.">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="18" />
                  <TextBlock DockPanel.Dock="Left" Text="4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Dim}" Width="18" Margin="6,0,6,0" VerticalAlignment="Center" />
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="False" IsEnabled="False" Margin="10,0,0,0" />
                  <TextBlock DockPanel.Dock="Right" Text="no key" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,26,0" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CSFloat" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="needs your API key · Doppler phases" FontSize="11" Foreground="{StaticResource Dim}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </c:CutBorder>

          <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
            <StackPanel Margin="16,12,16,4">
              <c:TrackedText Style="{StaticResource CardHead}" Text="App" Margin="0,0,0,14" />
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Start with Windows" />
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Style="{StaticResource SideNote}" Text="Starts minimised to the tray" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Close button" />
                <ComboBox Style="{StaticResource HudCombo}" Width="130" ItemsSource="{Binding CloseOptions}" SelectedItem="{Binding CloseAction}" />
                <TextBlock Style="{StaticResource SideNote}" Text="The tray icon keeps watching in the background" />
              </DockPanel>
            </StackPanel>
          </c:CutBorder>
        </StackPanel>

        <!-- Right column -->
        <StackPanel Grid.Column="2">
          <c:CutBorder Style="{StaticResource HudCard}">
            <StackPanel Margin="16,12,16,12">
              <Grid Margin="0,0,0,14">
                <c:TrackedText Style="{StaticResource CardHead}" Text="Overlay" />
                <Button Style="{StaticResource LinkButton}" Content="Show test card" HorizontalAlignment="Right" Command="{Binding ShowTestCardCommand}" />
              </Grid>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Show in game" />
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OverlayEnabled}" />
                <TextBlock Style="{StaticResource SideNote}" Text="Cards for new items, on top of CS2" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Position" VerticalAlignment="Top" Margin="0,6,12,0" />
                <Border Background="#0b1119" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="3" VerticalAlignment="Top">
                  <UniformGrid Columns="3" Rows="3">
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopLeft}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopCenter}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopRight}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=MiddleLeft}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=Center}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=MiddleRight}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomLeft}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomCenter}" />
                    <RadioButton Style="{StaticResource PosCell}" GroupName="pos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomRight}" />
                  </UniformGrid>
                </Border>
                <StackPanel Margin="14,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Note}" Text="Offset X" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Style="{StaticResource HudTextBox}" Width="48" Height="26" FontSize="12" Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Note}" Text="px   Y" VerticalAlignment="Center" Margin="6,0,6,0" />
                    <TextBox Style="{StaticResource HudTextBox}" Width="48" Height="26" FontSize="12" Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Note}" Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </StackPanel>
                  <ComboBox Style="{StaticResource HudCombo}" Width="200" Height="26" Margin="0,8,0,0" HorizontalAlignment="Left"
                            ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor}" />
                </StackPanel>
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Card size" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider Style="{StaticResource HudSlider}" Minimum="50" Maximum="160" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding SizePercent}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Opacity" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider Style="{StaticResource HudSlider}" Minimum="40" Maximum="100" SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="True"
                        Value="{Binding OpacityPercent}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="Show each card" />
                <ComboBox Style="{StaticResource HudCombo}" Width="100" ItemsSource="{Binding SecondsOptions}" SelectedItem="{Binding Seconds}" />
                <TextBlock Style="{StaticResource SideNote}" Text="Cards queue, one at a time" />
              </DockPanel>
              <DockPanel Style="{StaticResource Row}">
                <c:TrackedText Style="{StaticResource FieldLabel}" Text="While overlay is off" />
                <ComboBox Style="{StaticResource HudCombo}" Width="130" ItemsSource="{Binding WhileOffOptions}" SelectedItem="{Binding WhileOff}" />
                <TextBlock Style="{StaticResource SideNote}" Text="Items are always saved to history" />
              </DockPanel>
              <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" Padding="10,8">
                <DockPanel>
                  <Path DockPanel.Dock="Left" Data="{StaticResource IcoInfo}" Stroke="{StaticResource Gold}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,9,0" />
                  <TextBlock Style="{StaticResource Body}" FontSize="11.5" LineHeight="16" Foreground="{StaticResource Warn}"
                             Text="Run CS2 in borderless windowed mode (Fullscreen Windowed). In exclusive fullscreen the overlay can't be shown; items are still detected and saved." />
                </DockPanel>
              </Border>
            </StackPanel>
          </c:CutBorder>

          <c:CutBorder Style="{StaticResource HudCard}" Margin="0,14,0,0">
            <StackPanel Margin="16,12,16,12">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <c:TrackedText Style="{StaticResource CardHead}" Text="Hotkeys" />
                <c:TrackedText Style="{StaticResource MutedText}" Text="Click Change, then press 1–3 keys together" Margin="14,0,0,0" FontSize="10" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8">
                      <c:TrackedText Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                      <Button x:Name="btn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Change" Width="84" Height="28" Margin="8,0,0,0"
                              Command="{Binding DataContext.RecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      <Border x:Name="box" Background="{StaticResource Field}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Height="30" Padding="8,0">
                        <Grid>
                          <ItemsControl x:Name="keys" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource KeyCap}" ItemsPanel="{StaticResource Horizontal}" VerticalAlignment="Center" Focusable="False" />
                          <StackPanel x:Name="rec" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Width="6" Height="6" Fill="#ef7a7a" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <c:TrackedText Text="Press 1–3 keys…" FontSize="10.5" FontWeight="SemiBold" Spacing="1.2" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding LiveParts}" ItemTemplate="{StaticResource KeyCap}" ItemsPanel="{StaticResource Horizontal}" VerticalAlignment="Center" Focusable="False" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Recording}" Value="True">
                        <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="keys" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="rec" Property="Visibility" Value="Visible" />
                        <Setter TargetName="btn" Property="Content" Value="Cancel" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,4,0,0" Visibility="{Binding HotkeyMessage, Converter={StaticResource Vis}}">
                <Path x:Name="hkIcon" DockPanel.Dock="Left" Data="{StaticResource IcoCheck}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,8,0">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Stroke" Value="{StaticResource Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HotkeyKind}" Value="ok">
                          <Setter Property="Stroke" Value="{StaticResource Up}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HotkeyKind}" Value="warn">
                          <Setter Property="Stroke" Value="{StaticResource Warn}" />
                          <Setter Property="Data" Value="{StaticResource IcoInfo}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
                <TextBlock Style="{StaticResource StatusText}" Tag="{Binding HotkeyKind}" Text="{Binding HotkeyMessage}" FontSize="11.5" />
              </DockPanel>
              <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                         Text="Shortcuts are global, so they work while CS2 has focus. New shortcuts apply when you save." />
            </StackPanel>
          </c:CutBorder>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
