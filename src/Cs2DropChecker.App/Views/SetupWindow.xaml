<Window x:Class="Cs2DropChecker.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        Title="CS2 Drop Checker · Setup" Width="740" Height="700" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="H2" TargetType="c:TrackedText">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Spacing" Value="1.5" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Para" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#b8c4d4" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Small" TargetType="c:TrackedText">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Spacing" Value="0.7" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style x:Key="Bullet" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style x:Key="BulletText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="c:TrackedText" BasedOn="{StaticResource Lbl}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Width" Value="150" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Height" Value="40" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="20,0" />
    </Style>
    <Style x:Key="BigGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="40" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="18,0" />
    </Style>

    <DataTemplate x:Key="StepTemplate">
      <Button Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
              Focusable="False" Cursor="Hand" Height="46">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="bg" Background="Transparent" />
              <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Collapsed" />
              <ContentPresenter />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#08ffffff" />
              </Trigger>
              <DataTrigger Binding="{Binding State}" Value="on">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource NavOn}" />
                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
          <Border x:Name="num" Width="22" Height="22" BorderThickness="1" BorderBrush="#735d79ae" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="numText" Text="{Binding Number}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Path x:Name="check" Data="{StaticResource IcoCheck}" Stroke="{StaticResource Up}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <c:TrackedText x:Name="title" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Spacing="1.4" Foreground="{StaticResource Dim}" />
            <c:TrackedText Text="{Binding Subtitle}" FontSize="9.5" Spacing="1" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="on">
          <Setter TargetName="num" Property="Background" Value="{StaticResource Accent}" />
          <Setter TargetName="num" Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter TargetName="numText" Property="Foreground" Value="{StaticResource Ink}" />
          <Setter TargetName="numText" Property="FontWeight" Value="Bold" />
          <Setter TargetName="title" Property="Foreground" Value="White" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="done">
          <Setter TargetName="num" Property="BorderBrush" Value="{StaticResource Up}" />
          <Setter TargetName="numText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="check" Property="Visibility" Value="Visible" />
          <Setter TargetName="title" Property="Foreground" Value="{StaticResource Up}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border BorderBrush="#4d5d79ae" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Path Data="{StaticResource Diamond}" Fill="{StaticResource Accent}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <c:TrackedText Text="CS2 Drop Checker · Setup" FontSize="12" FontWeight="SemiBold" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource WinButton}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
              <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CloseButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Step rail -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
          <DockPanel Margin="0,20,0,16">
            <TextBlock DockPanel.Dock="Bottom" Margin="16,0,14,0" Style="{StaticResource Note}" FontSize="10.5"
                       Text="Everything here can be changed later in Settings." />
            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" Focusable="False" />
          </DockPanel>
        </Border>

        <!-- Step 1: profile -->
        <DockPanel Grid.Column="1" Margin="30,28,30,26" Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=0}">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource BigGhost}" Content="Not me" Command="{Binding NotMeCommand}"
                    Visibility="{Binding Profile, Converter={StaticResource Vis}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BigButton}" Content="This is me →" Command="{Binding ThisIsMeCommand}"
                    IsEnabled="{Binding Profile, Converter={StaticResource NotNull}}" />
          </DockPanel>
          <StackPanel>
            <c:TrackedText Style="{StaticResource H2}" Text="Who are you on Steam?" />
            <TextBlock Style="{StaticResource Para}"
                       Text="Paste your Steam profile link, SteamID64 or custom profile name. The app reads your CS2 inventory to spot new items." />
            <Grid>
              <TextBox x:Name="InputBox" Style="{StaticResource HudTextBox}" Height="40" FontSize="14" Padding="10,0,90,0"
                       Tag="steamcommunity.com/id/yourname" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding CheckCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <c:TrackedText Text="Checking…" FontSize="10.5" FontWeight="SemiBold" Spacing="1.2" Foreground="{StaticResource Gold}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"
                             Visibility="{Binding Busy, Converter={StaticResource Vis}}" />
            </Grid>
            <c:TrackedText Style="{StaticResource Small}" Margin="0,8,0,0"
                           Text="Accepted: /id/… or /profiles/… link · 17-digit SteamID64 · custom name" />
            <DockPanel Margin="0,14,0,0" Visibility="{Binding Error, Converter={StaticResource Vis}}">
              <Path DockPanel.Dock="Left" Data="{StaticResource IcoInfo}" Stroke="{StaticResource Down}" StrokeThickness="1.4" Width="13" Height="13"
                    Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,9,0" />
              <TextBlock Text="{Binding Error}" Foreground="{StaticResource Down}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" />
            </DockPanel>

            <Border Margin="0,18,0,0" Padding="14" BorderThickness="1" BorderBrush="#738fd19a" Background="{StaticResource CardBg}"
                    Visibility="{Binding Profile, Converter={StaticResource Vis}}">
              <DockPanel>
                <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                  <Border BorderBrush="#99de9b35" BorderThickness="1">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3a2a14" Offset="0" />
                        <GradientStop Color="#1c1408" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image x:Name="Avatar" Margin="1" Stretch="UniformToFill" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <c:TrackedText Text="{Binding Profile.Name}" FontSize="19" FontWeight="Bold" Spacing="1" />
                  <c:TrackedText Text="{Binding IdLine}" FontSize="11" Spacing="0.7" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding InventoryLine}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource StatusText}" Tag="{Binding InventoryKind}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <c:TrackedText Style="{StaticResource Small}" Margin="0,14,0,0" Text="Saved only on this PC, for your Windows user." />
          </StackPanel>
        </DockPanel>

        <!-- Step 2: sign-in -->
        <DockPanel Grid.Column="1" Margin="30,28,30,26" Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=1}">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource BigGhost}" Content="Back" Command="{Binding BackCommand}" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Left" Style="{StaticResource BigGhost}" Content="Skip for now" Command="{Binding SkipCommand}"
                    Visibility="{Binding SignedIn, Converter={StaticResource Vis}, ConverterParameter=!}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BigButton}" Content="Continue →" Command="{Binding SkipCommand}"
                    Visibility="{Binding SignedIn, Converter={StaticResource Vis}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BigButton}" Content="Sign in with Steam" Command="{Binding SignInCommand}"
                    IsEnabled="{Binding CanSignIn}">
              <Button.Visibility>
                <Binding Path="SignedIn" Converter="{StaticResource Vis}" ConverterParameter="!" />
              </Button.Visibility>
            </Button>
          </DockPanel>
          <StackPanel>
            <c:TrackedText Style="{StaticResource H2}" Text="See trades and purchases instantly" />
            <TextBlock Style="{StaticResource Para}"
                       Text="Steam hides items you trade for or buy on the market from public view for 7 days. If you sign in, the app reads your own inventory the way you see it on Steam and catches them right away." />
            <UniformGrid Columns="2" Margin="0,0,0,18">
              <Border Margin="0,0,5,0" Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
                <StackPanel>
                  <c:TrackedText Text="Without sign-in" FontSize="11" FontWeight="SemiBold" Spacing="1.4" Margin="0,0,0,4" />
                  <TextBlock FontSize="12" LineHeight="18" Foreground="#9fb0c6" TextWrapping="Wrap"
                             Text="Drops, cases, trade-ups: instant&#10;Trades, purchases: about 7 days late" />
                </StackPanel>
              </Border>
              <Border Margin="5,0,0,0" Padding="12,10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
                <StackPanel>
                  <c:TrackedText Text="With sign-in" FontSize="11" FontWeight="SemiBold" Spacing="1.4" Foreground="{StaticResource Up}" Margin="0,0,0,4" />
                  <TextBlock FontSize="12" LineHeight="18" Foreground="#9fb0c6" TextWrapping="Wrap"
                             Text="Everything instant&#10;Includes trade-protected items" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <DockPanel Style="{StaticResource Bullet}">
              <Border DockPanel.Dock="Left" Width="18" Height="18" Background="{StaticResource Up}" Margin="0,1,10,0" VerticalAlignment="Top">
                <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Ink}" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform" />
              </Border>
              <TextBlock Style="{StaticResource BulletText}" Text="Steam's own login page opens in a built-in browser window. Steam Guard and QR login work as usual." />
            </DockPanel>
            <DockPanel Style="{StaticResource Bullet}">
              <Border DockPanel.Dock="Left" Width="18" Height="18" Background="{StaticResource Up}" Margin="0,1,10,0" VerticalAlignment="Top">
                <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Ink}" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform" />
              </Border>
              <TextBlock Style="{StaticResource BulletText}" Text="The app never sees your password or login cookie. The login stays in that built-in browser, on this PC only, encrypted by Windows." />
            </DockPanel>
            <DockPanel Style="{StaticResource Bullet}">
              <Border DockPanel.Dock="Left" Width="18" Height="18" Background="{StaticResource Up}" Margin="0,1,10,0" VerticalAlignment="Top">
                <Path Data="{StaticResource IcoCheck}" Stroke="{StaticResource Ink}" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform" />
              </Border>
              <TextBlock Style="{StaticResource BulletText}" Text="Read-only: it only loads your own inventory. No trading, selling or listing. Sign out any time in Settings." />
            </DockPanel>
            <DockPanel Style="{StaticResource Bullet}">
              <Border DockPanel.Dock="Left" Width="18" Height="18" Background="{StaticResource Gold}" Margin="0,1,10,0" VerticalAlignment="Top">
                <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Style="{StaticResource BulletText}" Text="Anyone with access to your Windows account could use the session. Skip this on a shared PC." />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding SignedIn, Converter={StaticResource Vis}}">
              <Path DockPanel.Dock="Left" Data="{StaticResource IcoCheck}" Stroke="{StaticResource Up}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,2,9,0" VerticalAlignment="Top" />
              <TextBlock Text="Signed in. New trades and purchases show up right away." Foreground="{StaticResource Up}" FontSize="12.5" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding SignInNote, Converter={StaticResource Vis}}">
              <Path DockPanel.Dock="Left" Data="{StaticResource IcoInfo}" Stroke="{StaticResource Warn}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,2,9,0" VerticalAlignment="Top" />
              <TextBlock Text="{Binding SignInNote}" Foreground="{StaticResource Warn}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding CanSignIn, Converter={StaticResource Vis}, ConverterParameter=!}">
              <Path DockPanel.Dock="Left" Data="{StaticResource IcoInfo}" Stroke="{StaticResource Warn}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,2,9,0" VerticalAlignment="Top" />
              <TextBlock Foreground="{StaticResource Warn}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                         Text="Sign-in needs the Microsoft Edge WebView2 Runtime, which is missing on this PC. Install it from Microsoft, then sign in from Settings." />
            </DockPanel>
          </StackPanel>
        </DockPanel>

        <!-- Step 3: basics -->
        <DockPanel Grid.Column="1" Margin="30,28,30,26" Visibility="{Binding Step, Converter={StaticResource EqVis}, ConverterParameter=2}">
          <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource BigGhost}" Content="Back" Command="{Binding BackCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BigButton}" Content="Start watching" Command="{Binding FinishCommand}" />
          </DockPanel>
          <StackPanel>
            <c:TrackedText Style="{StaticResource H2}" Text="A few basics" />
            <TextBlock Style="{StaticResource Para}"
                       Text="Pick the currency for prices and where new-item cards appear over CS2. The app then sits in the tray and checks your inventory every few minutes." />

            <DockPanel Margin="0,0,0,16">
              <c:TrackedText Style="{StaticResource FieldLabel}" Text="Currency" />
              <ComboBox Style="{StaticResource HudCombo}" Width="110" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" />
              <TextBlock Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" Text="Steam prices in your wallet currency" />
            </DockPanel>
            <DockPanel Margin="0,0,0,16">
              <c:TrackedText Style="{StaticResource FieldLabel}" Text="Start with Windows" />
              <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" />
              <TextBlock Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" Text="Starts minimised to the tray" />
            </DockPanel>
            <DockPanel Margin="0,0,0,18">
              <c:TrackedText Style="{StaticResource FieldLabel}" Text="Card position" VerticalAlignment="Top" Margin="0,6,12,0" />
              <Border Background="#0b1119" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="3" VerticalAlignment="Top">
                <UniformGrid Columns="3" Rows="3">
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopLeft}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopCenter}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=TopRight}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=MiddleLeft}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=Center}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=MiddleRight}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomLeft}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomCenter}" />
                  <RadioButton Style="{StaticResource PosCell}" GroupName="setupPos" IsChecked="{Binding Position, Converter={StaticResource EqBool}, ConverterParameter=BottomRight}" />
                </UniformGrid>
              </Border>
              <TextBlock Style="{StaticResource Note}" Margin="14,0,0,0" VerticalAlignment="Top"
                         Text="Cards show on top of CS2 when it runs in borderless windowed mode (Fullscreen Windowed). Items are always saved to history." />
            </DockPanel>

            <c:TrackedText Style="{StaticResource Lbl}" FontSize="10.5" Text="Hotkeys" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Text2}" Width="162" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource KeyCap}" ItemsPanel="{StaticResource Horizontal}" VerticalAlignment="Center" Focusable="False" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Text="They work while CS2 has focus. Change them in Settings." />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
