<UserControl x:Class="Cs2DropChecker.App.Views.ShareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
             RenderOptions.BitmapScalingMode="HighQuality">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0f1826" Offset="0" />
        <GradientStop Color="#070b11" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Rectangle Fill="{Binding Glow}" />
    <Rectangle Fill="{StaticResource Scanlines}" Opacity="0.6" />
    <Border BorderBrush="{Binding RarityBrush}" BorderThickness="1" Opacity="0.7" />
    <Grid Margin="26,24,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="52" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Source="{Binding Image}" Stretch="Uniform" Margin="0,4,18,8" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding RarityLine}" FontSize="13" FontWeight="Bold" Foreground="{Binding RarityBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Weapon}" FontSize="14" Foreground="#9fb0c6" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Skin}" FontSize="26" FontWeight="Bold" Foreground="#f2f5f8" TextWrapping="Wrap" MaxHeight="68" TextTrimming="CharacterEllipsis" LineHeight="32" />
        <Border BorderBrush="#735d79ae" BorderThickness="1" Padding="7,2" Margin="0,10,0,0" HorizontalAlignment="Left"
                Visibility="{Binding Wear, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding Wear}" FontSize="12" Foreground="#c9d2de" />
        </Border>
        <TextBlock Text="{Binding Price}" FontSize="34" FontWeight="Bold" Foreground="#f3b350" Margin="0,14,0,0" />
        <TextBlock Text="{Binding How}" FontSize="12.5" Foreground="#8fa0b6" Margin="0,2,0,0" />
      </StackPanel>
      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#335d79ae" BorderThickness="0,1,0,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowProfile, Converter={StaticResource Vis}}">
            <Border Width="28" Height="28" Background="#1a2433" Visibility="{Binding Avatar, Converter={StaticResource Vis}}">
              <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="{Binding ProfileName}" FontSize="13" FontWeight="SemiBold" Foreground="#e6ebf1" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75">
            <Path Data="{StaticResource Diamond}" Fill="#de9b35" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="CS2 DROP CHECKER" FontSize="10" FontWeight="Bold" Foreground="#8fa0b6" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{Binding RarityBrush}" />
  </Grid>
</UserControl>
