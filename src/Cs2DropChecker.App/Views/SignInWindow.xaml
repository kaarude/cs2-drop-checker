<Window x:Class="Cs2DropChecker.App.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cs2DropChecker.App.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Steam" Width="600" Height="760" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource HudFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="/Assets/app.ico" ShowInTaskbar="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#4d5d79ae" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Path Data="{StaticResource Diamond}" Fill="{StaticResource Accent}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <c:TrackedText Text="Sign in to Steam" FontSize="12" FontWeight="SemiBold" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
          </Button>
        </Grid>
      </Border>

      <!-- Address line so the user can see this is Steam's own page -->
      <Border Grid.Row="1" Background="#0a0f16" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
        <DockPanel Margin="14,0" VerticalAlignment="Center">
          <Path DockPanel.Dock="Left" Data="M3,7 V5 A4,4 0 0 1 11,5 V7 M1.5,7 H12.5 V14 H1.5 Z" Stroke="{StaticResource Up}" StrokeThickness="1.3"
                Width="11" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0" x:Name="Lock" />
          <c:TrackedText x:Name="StatusLine" DockPanel.Dock="Right" Text="" FontSize="10" Spacing="1.2" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
          <TextBlock x:Name="Address" Text="steamcommunity.com" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="2" Background="#171a21">
        <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
          <c:TrackedText Text="Loading Steam login…" FontSize="12" FontWeight="SemiBold" Spacing="1.6" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="Failure" VerticalAlignment="Center" Margin="40,0" Visibility="Collapsed">
          <c:TrackedText Text="Could not open the Steam login" FontSize="14" FontWeight="Bold" Spacing="1.6" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" />
          <TextBlock x:Name="FailureText" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />
      </Grid>

      <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="14,9">
        <TextBlock Style="{StaticResource Note}" FontSize="11"
                   Text="This is Steam's own login page. The app never sees your password or login cookie. It reads your inventory and market prices, and only lists or removes items on the market when you ask. Close this window to cancel." />
      </Border>
    </Grid>
  </Border>
</Window>
